# =====================================================================
# Git Ignore Configuration for Web Excel Formula Intelligence
# =====================================================================

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
*.py[cod]
*$py.class
__pycache__/
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
htmlcov/
.coverage

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.pnp
frontend/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# --- Uploads & Large Test Excel Files ---
# Ignore files uploaded to backend
backend/uploads/*
!backend/uploads/.gitkeep

# Ignore loose/testing excel workbooks in root (keep samples)
*.xlsx
*.xlsm
*.xls
*.csv
!backend/samples/*.xlsx
!backend/samples/*.xlsm

# --- IDE & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --- Logs & Scratch Scripts ---
*.log
scratch/
